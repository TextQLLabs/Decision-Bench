# Copy to .env (scripts/run.py loads it; for plain `inspect eval`, Inspect reads .env too).

# Model providers: only the ones you run.
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# FIREWORKS_API_KEY=          # Kimi K3, DeepSeek V4.1 Flash, GLM 5.3 Flash, Qwen 3.8 Max
# META_API_KEY=               # Muse Spark 1.3
# GOOGLE_APPLICATION_CREDENTIALS=   # Gemini 3.8 Flash on Vertex, with
# GOOGLE_CLOUD_PROJECT=

# The warehouse. DuckDB: the file scripts/load_duckdb.py wrote.
DECISION_BENCH_WAREHOUSE_ENGINE=duckdb
DECISION_BENCH_WAREHOUSE_DATABASE=data/decision_bench.duckdb
DECISION_BENCH_WAREHOUSE_SCHEMA=food_delivery
# BigQuery instead: the project you loaded the release into, and a read-only key (or adc).
# DECISION_BENCH_WAREHOUSE_ENGINE=bigquery
# DECISION_BENCH_WAREHOUSE_DATABASE=my-project
# DECISION_BENCH_WAREHOUSE_CREDENTIALS=path/to/reader-key.json

# Where run_python runs: local, docker or k8s.
DECISION_BENCH_SANDBOX=local
# DECISION_BENCH_SANDBOX_IMAGE=decision-bench-sandbox
